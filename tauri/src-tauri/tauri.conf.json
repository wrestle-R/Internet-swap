{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Internet Swap",
  "version": "0.1.1",
  "identifier": "io.github.wrestle-r.internet-swap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Internet Swap",
        "width": 480,
        "height": 720,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "network-manager",
          "curl",
          "coreutils"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
